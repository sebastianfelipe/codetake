{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeTake",
  "mainBinaryName": "CodeTake",
  "version": "0.1.1",
  "identifier": "dev.codetake.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CodeTake",
        "width": 1040,
        "height": 760,
        "minWidth": 880,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../assets/music/": "music/"
    },
    "category": "Video",
    "shortDescription": "Record your code.",
    "longDescription": "A free, open-source, local-first screen and webcam recorder for developers.",
    "copyright": "© 2026 CodeTake contributors. MIT License.",
    "license": "MIT",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "./Entitlements.plist",
      "signingIdentity": "-",
      "hardenedRuntime": true
    },
    "linux": {
      "deb": {
        "section": "video"
      }
    }
  }
}
